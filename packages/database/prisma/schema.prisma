generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// CORE XRPL TRACKING
// -----------------------------------------------------------------------------

model IndexerState {
  id              String   @id @default("default")
  lastLedgerIndex Int      @default(0)
  totalTxCount    Int      @default(0)
  totalVolumeXrp  Float    @default(0)
  updatedAt       DateTime @updatedAt
}

// Known x402 facilitator source tags.
// Any XRPL Payment with a SourceTag matching one of these is an x402 payment.
model FacilitatorTag {
  id        String   @id @default(uuid())
  sourceTag Int      @unique
  name      String
  url       String?
  isActive  Boolean  @default(true)
  description String?
  logoUrl    String?
  website    String?
  networks   String[] @default([])
  assets     String[] @default([])
  status     String   @default("listed")
  submittedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DirectoryListing {
  id            String   @id @default(cuid())
  name          String
  tagline       String?
  description   String?
  website       String?
  logoUrl       String?
  category      String?
  useCase       String?
  asset         String?
  merchantAddr  String?
  contactEmail  String?
  verified402   Boolean  @default(false)
  status        String   @default("pending") // pending | approved | rejected
  partnerType   String   @default("service")  // service | merchant-network
  reviewComment String?
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, partnerType])
}

// -----------------------------------------------------------------------------
// X402 ECOSYSTEM
// -----------------------------------------------------------------------------

model Merchant {
  address      String     @id // XRPL classic address (r...)
  name         String?
  description  String?
  website      String?
  logoUrl      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  resources    Resource[]
  transactions Transaction[]
}

model Resource {
  id           String     @id @default(uuid())
  merchantAddr String
  merchant     Merchant   @relation(fields: [merchantAddr], references: [address])
  
  url          String
  name         String?
  description  String?
  
  priceAmount  String
  priceAsset   String
  
  schema       String?    // e.g., "x402"
  network      String?    @default("xrpl")
  
  isDiscovered Boolean    @default(false)
  isActive     Boolean    @default(true)
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  transactions Transaction[]

  @@unique([merchantAddr, url])
  @@index([isActive, createdAt])
}

model Transaction {
  hash         String     @id // XRPL transaction hash
  ledgerIndex  Int
  timestamp    DateTime
  
  buyerAddress String
  
  merchantAddr String
  merchant     Merchant   @relation(fields: [merchantAddr], references: [address])
  
  resourceId   String?
  resource     Resource?  @relation(fields: [resourceId], references: [id])
  
  amount       String
  asset        String     // "XRP" or currency code
  assetIssuer  String?    // Issuer address for IOUs (null for XRP)
  
  facilitator  String?    // Name of the facilitator that settled this payment

  sourceTag      Int?     // x402 facilitator identifier (e.g. 804681468)
  destinationTag Int?     // Optional routing tag
  invoiceId      String?  // Invoice ID from the x402 payment (hex or plain)
  
  rawMemo      String?    // Raw MemoData for debugging

  verifiableIntent Boolean @default(false)  // carried an X402 Secure Verifiable Intent chain (L1-L3)
  riskChecked      Boolean @default(false)  // passed X402 Secure risk control before settlement
  
  createdAt    DateTime   @default(now())

  @@index([merchantAddr, timestamp])
  @@index([buyerAddress, timestamp])
  @@index([sourceTag])
  @@index([timestamp])
}
