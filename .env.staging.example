# ── Staging environment for the x402-xrpl backend ──────────────────────────────
# Copy to .env.staging (gitignored) and fill in real values:
#     cp .env.staging.example .env.staging
#
# Loaded by docker-compose.staging.yml. Staging is fully ISOLATED from production:
# separate database, volume, and host ports. Nothing here touches the prod stack.

# ── Postgres (staging) ─────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-staging-db
POSTGRES_DB=x402_xrpl_staging

# ── Host port mappings (offset from the default stack so both can coexist) ──────
STAGING_DB_PORT=5433      # default stack uses 5432
STAGING_API_PORT=4101     # default stack uses 4001
STAGING_HEALTH_PORT=4100  # indexer health; default uses 4000
STAGING_WEB_PORT=3100     # only used with --profile with-web; default uses 3000

# ── API admin auth (required) ──────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-staging-admin
ADMIN_SESSION_SECRET=change-me-staging-session-secret

# ── Indexer XRPL endpoint ──────────────────────────────────────────────────────
#   Mainnet (prod-like, realistic Index data):  wss://s1.ripple.com:51233
#   Testnet (safe, low volume):                 wss://s.altnet.rippletest.net:51233
STAGING_XRPL_WSS=wss://s1.ripple.com:51233

# ── Web (only when running the optional `with-web` profile) ─────────────────────
NEXT_PUBLIC_XRPL_NETWORK=mainnet

# ── Host-facing DB URL ─────────────────────────────────────────────────────────
# Used when running `prisma db push` from your machine (note the host port, 5433):
#   DATABASE_URL="postgresql://postgres:change-me-staging-db@localhost:5433/x402_xrpl_staging" pnpm staging:db:push
