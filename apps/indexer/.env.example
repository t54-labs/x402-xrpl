# XRPL WebSocket endpoint (testnet default)
XRPL_WSS=wss://s.altnet.rippletest.net:51233

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/x402_xrpl

# Health check server port (optional, default 4000)
HEALTH_PORT=4000

# Optional VI receipt enrichment. When enabled, the indexer POSTs recent
# indexed tx hashes/invoice IDs to this read-only lookup service and upgrades
# Transaction.verifiableIntent/riskChecked when a verified x402 Secure receipt
# is found. The expected request body is:
# { "transactions": [{ "hash": "...", "invoiceId": "...", "rawMemo": "..." }] }
VI_RECEIPT_LOOKUP_URL=
VI_RECEIPT_LOOKUP_TOKEN=
VI_RECEIPT_LOOKUP_TIMEOUT_MS=5000
VI_RECEIPT_ENRICHMENT_BATCH_SIZE=50
VI_RECEIPT_ENRICHMENT_INTERVAL_MS=60000
VI_RECEIPT_ENRICHMENT_LOOKBACK_HOURS=24

# Starting ledger for backfill (optional, defaults to earliest available)
# BACKFILL_START_LEDGER=
