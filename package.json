{
  "name": "x402-xrpl-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @x402-xrpl/database generate",
    "db:migrate": "pnpm --filter @x402-xrpl/database db:migrate",
    "db:deploy": "pnpm --filter @x402-xrpl/database db:deploy"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@9.0.0"
}
